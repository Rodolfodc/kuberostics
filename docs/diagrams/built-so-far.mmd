%% Deployment view: what runs where, by component. Reflects main c48b385 (merged PRs #5 to #14, #16 to #18, #20 to #23, #25) plus open PRs #15, #26 (2026-11-24). Refresh after merges.
%% Colour: green = merged on main; light green dashed = partial (pure core merged, ROS node planned); amber = in an open PR (number); grey = planned only.
%% Shape: rectangle = lifecycle node under a manager; hexagon = plain node (D-26); dashed border = third-party (Art. II).
flowchart TB
  classDef merged fill:#d4edda,stroke:#2e7d32,color:#000
  classDef pr fill:#fff3cd,stroke:#b58900,color:#000
  classDef planned fill:#eeeeee,stroke:#777,color:#555
  classDef partial fill:#e8f5c8,stroke:#2e7d32,color:#000,stroke-dasharray: 3 3
  classDef third stroke:#222,stroke-width:2px,stroke-dasharray: 5 3

  subgraph LEG["Legend"]
    direction LR
    L1["merged on main"]:::merged
    L2["open PR"]:::pr
    L7["partial: pure core merged, node planned"]:::partial
    L3["planned only"]:::planned
    L4{{"plain node"}}:::merged
    L5["lifecycle node"]:::merged
    L6["third-party: dashed border"]:::third
  end

  subgraph HOST["HOST machine (outside Docker)"]
    SIM["CoppeliaSim 4.10 (third-party)<br/>House scene + myRobot.ttm<br/>ZeroMQ remote API :23000<br/>3.6 steps/s with robot, bench merged (#14), record of D-11 open (#15)"]:::pr
  end

  subgraph ROBOT["ROBOT: ROS 2 containers, Jazzy or Lyrical, network_mode host, /myRobot"]
    direction LR

    subgraph C_LIFE["Component: lifecycle managers"]
      direction LR
      LMC["lifecycle_manager_core"]:::merged
      SEQ{{"lifecycle_sequencer<br/>(#25, D-26)<br/>opt-in: with_sequencer, default false"}}:::merged
      LMN["lifecycle_manager_nav<br/>autostart false, planner, controller, bt_navigator<br/>launched with nav:=true"]:::merged
      LMO["lifecycle_manager_optional<br/>not launched while its node list is empty<br/>(until spec 009b)"]:::merged
      MQB["MQTT bridge<br/>optional, spec 009b"]:::planned
    end

    subgraph C_BEH["Component: behaviour and supervision"]
      direction LR
      BEH["behaviour_server<br/>mode every 0.2 s"]:::third
      IAO["IA368II servers<br/>myrobot, cleaning, autodocking,<br/>charging, charged"]:::third
      SUP["supervisor<br/>SubmodeMachine, submode,<br/>lock_stop, escape_server_wait_s (#10)"]:::merged
    end

    subgraph C_SAFE["Component: safety and motion chain"]
      direction LR
      SG["stop_guard<br/>zero Twist 10 Hz (D-22)<br/>shutdown fix (#10)"]:::merged
      MUX{{"twist_mux<br/>stop 250, lock 200, teleop 100,<br/>escape 80, nav 60, coverage 50, docking 40"}}:::third
      TEL{{"teleop_twist_keyboard"}}:::third
    end

    subgraph C_COV["Component: coverage and escape"]
      direction LR
      COV["coverage_server<br/>stub now, mux/coverage<br/>real: Nav2 waypoints (#12)"]:::merged
      ESC["escape_server<br/>stub now, mux/escape<br/>SIGINT fix (#10)"]:::merged
      STK["stuck_detector<br/>stub, trigger service"]:::merged
    end

    subgraph C_NAV["Component: mapping and navigation (spec 003, 005)"]
      direction LR
      MAPN["room_segmenter, room_tracker, MapDiff, room_labeler<br/>pure cores merged (#22)<br/>odom_tf_bridge, room_segmenter node,<br/>exploration_server, slam_toolbox planned"]:::partial
      NAV["planner_server, controller_server,<br/>bt_navigator<br/>controller on mux/nav"]:::planned
    end

    subgraph C_PERC["Component: perception offload (spec 009a)"]
      direction LR
      THR{{"image_throttle<br/>RGB 2 Hz, compressed (#21)"}}:::merged
      DLOC["detector_local<br/>yolo11n"]:::planned
      DSEL["detection_selector node<br/>(#21)"]:::merged
      SELC["selector_core<br/>pure Python, circuit breaker<br/>tests #11, rulings #13"]:::merged
      PROJ["projector node<br/>planned: #24 merged into the #21 branch,<br/>after #21 reached main, so not on main"]:::planned
      PROC["projection_core<br/>pure Python, TF at photo stamp<br/>tests #11"]:::merged
      SEM["semantic node<br/>2025S2, D-16"]:::third
    end

    subgraph C_BRG["Component: simulator bridges (2025S2)"]
      direction LR
      WHL{{"my_robot_cmd_vel_node<br/>wheel bridge, plain<br/>/cmd_vel remapped (D-06)"}}:::third
      SNS["scan, vision, odometry,<br/>sim_control nodes<br/>not in the D-26 table<br/>/scan /camera /camera_depth /myrobot/odom"]:::third
    end
  end

  subgraph CLOUD["CLOUD side: local K3s, optional (Art. VII)"]
    direction LR
    TRN["transport robot to K3s<br/>rmw_zenoh or zenoh-bridge-ros2dds<br/>measured (#16), owner decides Q-06 (#18)"]:::merged
    DCL["detector_cloud pod<br/>yolo11x"]:::planned
    MQ["Mosquitto, MinIO,<br/>retraining jobs, weights<br/>(spec 009b)"]:::planned
  end

  subgraph DEV["OPERATOR and DEV tooling (host)"]
    direction LR
    DEVT["scripts/test-docker.sh, CI matrix (#5),<br/>tools/sim_bench (#14), tools/sim.sh,<br/>ia368ii-check (#17), transport-bench (#16),<br/>render-diagrams.sh<br/>(naming cleanup #26: open)"]:::merged
  end

  LMC -.->|"manages"| SUP
  LMC -.->|"manages"| SG
  LMC -.->|"manages"| COV
  SEQ -.->|"starts, waits is_active"| LMC
  SEQ -.-> LMN
  SEQ -.-> LMO
  BEH -->|"/myRobot/behaviour/mode"| SUP
  STK -->|"/myRobot/stuck"| SUP
  SUP -->|"action cover_room"| COV
  SUP -->|"action escape"| ESC
  SUP -->|"/mux/lock_stop"| SG
  SG -->|"mux/stop"| MUX
  COV -->|"mux/coverage"| MUX
  ESC -->|"mux/escape"| MUX
  NAV -.->|"mux/nav"| MUX
  TEL -->|"mux/teleop"| MUX
  IAO -->|"mux/docking"| MUX
  MUX ==>|"/myRobot/cmd_vel (Twist)"| WHL
  WHL <==>|"ZeroMQ :23000 (D-14)"| SIM
  SNS <==>|"ZeroMQ :23000"| SIM
  SNS -->|"sensors"| MAPN
  SNS -->|"RGB, depth"| THR
  THR --> DLOC
  DLOC --> DSEL
  DSEL --> PROJ
  PROJ -->|"/detections_markers"| SEM
  THR <-.->|"compressed RGB only"| TRN
  TRN <-.-> DCL
  DSEL <-.->|"detections, offload_status"| TRN
  BEH -.->|"mode CHARGED triggers sync"| MQB
  MQB -.->|"MQTT, only at the dock"| MQ
  LMO -.->|"manages"| MQB
  DSEL --- SELC
  PROJ --- PROC
  DEVT -.->|"builds, tests, measures"| ROBOT
