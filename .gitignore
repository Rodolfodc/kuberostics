build/
install/
log/
src/deps/
__pycache__/
.sim/
.k3s/
.terraform/
*.tfstate*
rl/runs/

# Cenas e modelos do CoppeliaSim (.ttt/.ttm): material de terceiros, nunca versionar; ver models/README.md
*.ttt
*.ttm
.venv/
.pytest_cache/
*.egg-info/
.archify/
docs/diagrams/archify/*.json

# Generated or run-time artifacts (raw logs, measurement CSVs, temporary outputs) stay on the local machine, never in git
deploy/measurements/**/*.log
deploy/measurements/**/*.csv
**/local-logs/

# Model weights and rosbags are never committed (supplied by volume at run time; bags are local measurement output)
*.pt
*.onnx
*.mcap
*.db3
.tf-render/

# Chaos run output (rosbags, kills.csv, reports): local only
tools/chaos/local-logs/

# Coverage data
.coverage
