<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vacuum_supervisor</name>
  <version>0.1.0</version>
  <description>Submode supervisor (D-01): hierarchical state machine over the orchestrator mode.</description>
  <maintainer email="rodolfo.dalla.costa@hotmail.com">Rodolfo Dalla Costa</maintainer>
